# Copy this file to .env.local and set your own values.

# The password for /cockpit/login. Also signs login sessions, so changing it
# logs everyone out. Quote it if it contains # (e.g. ADMIN_PASSWORD='a#b').
ADMIN_PASSWORD=

# Supabase (or any Postgres) connection string. Required on Vercel — without it
# the cockpit and lead form can't save anything there.
# Supabase → Connect → "Transaction pooler" (port 6543), with your DB password filled in:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave unset locally to store data in ./data/*.json instead.
DATABASE_URL=

# Email alerts to you on every new call-back and quotation, via Resend (resend.com).
# Leave RESEND_API_KEY unset to skip emails. NOTIFY_EMAIL can be a comma-separated list.
# NOTIFY_FROM must use a domain verified in Resend (e.g. "Bluvig <hello@bluvig.co.ke>").
# Setting it also turns on the confirmation email to prospects who leave an email;
# until then, Resend's test sender only delivers to your Resend account's own email.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# WhatsApp alerts to you on every new lead and quotation, through a self-hosted
# OpenWA gateway (github.com/rmyndharis/OpenWA) on an always-on server.
# Leave any of these unset to skip WhatsApp. Link a spare number to OpenWA, not
# your main one: it uses unofficial WhatsApp clients that can get a number banned.
# OPENWA_URL: the gateway's public address, e.g. https://wa.example.com
# OPENWA_SESSION: the session id created in the OpenWA dashboard
# OPENWA_NOTIFY_TO: your WhatsApp number(s), comma-separated, e.g. 254700574125
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION=
OPENWA_NOTIFY_TO=
