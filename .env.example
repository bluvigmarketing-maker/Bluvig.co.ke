# Copy this file to .env.local and set your own values.

# Secret for /cockpit. Signs login sessions (changing it logs everyone out) and
# is the setup password for creating the FIRST passkey at /cockpit/login.
# After that, cockpit sign-in is a passkey only (fingerprint / Face ID /
# Windows Hello, or a phone via QR) — this password no longer signs you in.
ADMIN_PASSWORD=

# Passkeys are bound to this origin. Required in production, e.g.:
# WEBAUTHN_ORIGIN=https://bluvig.co.ke
# Leave unset in development (falls back to the request URL, e.g. http://localhost:3000).
WEBAUTHN_ORIGIN=

# Supabase (or any Postgres) connection string. Required on Vercel — without it
# the cockpit, authenticator and lead form can't save anything there.
# Supabase → Connect → "Transaction pooler" (port 6543), with your DB password filled in:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave unset locally to store data in ./data/*.json instead.
DATABASE_URL=

# Email alerts to you on every new call-back and quotation, via Resend (resend.com).
# Leave RESEND_API_KEY unset to skip emails. NOTIFY_EMAIL can be a comma-separated list.
# NOTIFY_FROM must use a domain verified in Resend (e.g. "Bluvig <hello@bluvig.co.ke>");
# until then, Resend's test sender only delivers to your Resend account's own email.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
